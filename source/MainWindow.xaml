<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Endfield" Width="420" Height="710" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" FontFamily="{DynamicResource LocaleFontFamily}" Foreground="{DynamicResource ThemeTextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.72"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.62"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/><Setter Property="Background" Value="{DynamicResource ThemeInputBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><TextBlock Text="⌄" Foreground="{DynamicResource ThemeMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,1" FontSize="15"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,0,28,0" VerticalAlignment="Center"/>
          <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
            <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,3,0,0"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemFace" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="2" CornerRadius="4"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFace" Property="Background" Value="{DynamicResource ThemeSelectionBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFace" Property="Background" Value="{DynamicResource ThemeSelectionBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="HoverCloseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger>
        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ContextMenu"><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="MenuFace" Background="Transparent" Padding="9,9" CornerRadius="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="MenuCheck" Text="✓" Visibility="Hidden" Foreground="{DynamicResource ThemeAccentBrush}"/>
          <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"/>
        </Grid></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuFace" Property="Background" Value="{DynamicResource ThemeSelectionBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="MenuCheck" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource ThemeBorderBrush}" Margin="9,4"/></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Viewbox x:Name="WidgetViewport" Stretch="Uniform"><Grid x:Name="WidgetLayout" Width="420" Height="710">
  <Border x:Name="FullView" Margin="6" CornerRadius="18" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Background="{DynamicResource WidgetBackgroundBrush}">
    <Grid>
      <Grid.Clip><RectangleGeometry Rect="0,0,406,696" RadiusX="17" RadiusY="17"/></Grid.Clip>
      <Grid x:Name="HeroArt" Height="279" VerticalAlignment="Top" IsHitTestVisible="False" ClipToBounds="True">
        <Grid.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.7"/><GradientStop Color="#B4FFFFFF" Offset="0.86"/><GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush></Grid.OpacityMask>
        <Grid.Background><RadialGradientBrush Center="0.9,0.4" GradientOrigin="0.9,0.4" RadiusX="1" RadiusY="1">
          <GradientStop x:Name="ArtGlow" Color="{DynamicResource WidgetGlowColor}" Offset="0"/><GradientStop Color="{DynamicResource WidgetBackgroundColor}" Offset="1"/>
        </RadialGradientBrush></Grid.Background>
        <TextBlock x:Name="ArtWatermark" Text="EF" FontSize="184" FontWeight="Black" Foreground="{DynamicResource ThemeWatermarkBrush}" Margin="-16,43,0,0"/>
        <Line X1="0" Y1="215" X2="410" Y2="12" Stroke="{DynamicResource ThemeLineBrush}" StrokeThickness="1"/>
        <Line X1="86" Y1="282" X2="420" Y2="116" Stroke="{DynamicResource ThemeLineBrush}" StrokeThickness="1"/>
        <Grid x:Name="PortraitFade" Width="265" Height="263" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,-8,0" ClipToBounds="True">
          <Grid.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.07"/><GradientStop Color="#FFFFFFFF" Offset="0.56"/><GradientStop Color="#70FFFFFF" Offset="0.82"/><GradientStop Color="#00FFFFFF" Offset="1"/>
          </LinearGradientBrush></Grid.OpacityMask>
        <Grid x:Name="FullPortraitTransform" Width="265" Height="338" VerticalAlignment="Top"><Grid.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.05"/><GradientStop Color="#FFFFFFFF" Offset="0.62"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Grid.OpacityMask>
        <Image x:Name="OperatorImage" Width="265" Height="338" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality">
          <Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.24"/><GradientStop Color="#FFFFFFFF" Offset="0.93"/><GradientStop Color="#00FFFFFF" Offset="1"/>
          </LinearGradientBrush></Image.OpacityMask>
        </Image>
        </Grid>
        </Grid>
        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="{DynamicResource WidgetClearColor}" Offset="0.46"/><GradientStop Color="{DynamicResource WidgetFadeColor}" Offset="0.89"/><GradientStop Color="{DynamicResource WidgetBackgroundColor}" Offset="1"/>
        </LinearGradientBrush></Rectangle.Fill></Rectangle>
        <Rectangle Width="260" HorizontalAlignment="Left"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="{DynamicResource WidgetShadeColor}" Offset="0"/><GradientStop Color="{DynamicResource WidgetClearColor}" Offset="1"/>
        </LinearGradientBrush></Rectangle.Fill></Rectangle>
      </Grid>
      <Grid x:Name="FullContent" Margin="18,16">
        <Grid.RowDefinitions><RowDefinition Height="218"/><RowDefinition Height="135"/><RowDefinition x:Name="FullUpdateRow" Height="145"/><RowDefinition x:Name="FullNextRow" Height="78"/><RowDefinition x:Name="FullPlayRow" Height="53"/><RowDefinition Height="35"/></Grid.RowDefinitions>
        <Grid x:Name="DragHandle" Background="Transparent">
          <StackPanel VerticalAlignment="Top">
            <TextBlock Text="ARKNIGHTS" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="9" FontWeight="SemiBold"/>
            <TextBlock Text="ENDFIELD" FontSize="28" FontWeight="Bold" Margin="-1,2,0,0"/>
          </StackPanel>
          <Button x:Name="CloseButton" Style="{StaticResource HoverCloseButton}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" Background="{DynamicResource ThemeChromeBrush}" ToolTip="{DynamicResource Locale.ab8c3af14fb614b63eecda1f}" AutomationProperties.Name="{DynamicResource Locale.d68748b60c6e5235c59caa3c}">
            <Path Width="10" Height="10" Stretch="Uniform" Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource ThemeTextBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,17" MaxWidth="240" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="DebutBadge" CornerRadius="3" Background="{DynamicResource ThemeBadgeBrush}" Padding="6,3"><TextBlock Text="{DynamicResource Locale.85c595039904105fe0e0cac1}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}"/></Border>
              <TextBlock Text="{DynamicResource Locale.b4da21734593fc93dc34923a}" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="8" Margin="8,3,0,0"/>
            </StackPanel>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxWidth="230" Margin="0,5,0,0"><TextBlock x:Name="OperatorName" Text="{DynamicResource Locale.917b7ef2d2387b6d4e854add}" FontSize="23" FontWeight="SemiBold"/></Viewbox>
            <TextBlock x:Name="BannerLabel" Text="Winter Hunt" FontSize="10" Foreground="{DynamicResource ThemeSoftAccentBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="BannerEndLabel" Visibility="Collapsed" FontSize="9" Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>
        <Border x:Name="FullSanityCard" Grid.Row="1" Background="{DynamicResource WidgetRaisedBrush}" CornerRadius="11" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
          <Grid x:Name="FullSanityLayout">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◇" FontSize="11" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Locale.919bd23a0d8fbbd3f2bf9e95}" FontSize="10" Foreground="{DynamicResource ThemeSecondaryTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
              <TextBlock x:Name="AccountLabel" Grid.Column="1" Text="{DynamicResource Locale.00229b693fa6d399fa73d017}" FontSize="10" Foreground="{DynamicResource ThemeMutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
            </Grid>
            <Grid x:Name="FullSanityValueRow" Grid.Row="1" Margin="0,6,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SanityNumber" Text="—" FontSize="32" FontWeight="Normal" Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="SanityMaximum" Text=" / —" FontSize="32" FontWeight="Normal" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
              </StackPanel>
              <TextBlock x:Name="SanityPercent" Grid.Column="1" Text="—" FontSize="12" Foreground="{DynamicResource ThemeAccentBrush}" Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
              <Grid x:Name="FullSanityRing" Grid.Column="1" Width="50" Height="50" Margin="14,0,0,0" Visibility="Collapsed"><Ellipse Margin="3" Stroke="{DynamicResource ThemeTrackBrush}" StrokeThickness="3"/><Path x:Name="FullRingArc" Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="{Binding Text, ElementName=SanityPercent}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeAccentBrush}"/></Grid>
            </Grid>
            <ProgressBar x:Name="SanityBar" Grid.Row="2" Height="3" VerticalAlignment="Top" Maximum="100" Value="0" Background="{DynamicResource ThemeTrackBrush}" Foreground="{DynamicResource ThemeAccentBrush}" BorderThickness="0"/>
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
              <TextBlock x:Name="RecoveryLabel" Text="{DynamicResource Locale.83b5e79cff0044bdf44f5780}" FontSize="11" Foreground="{DynamicResource ThemeSecondaryTextBrush}" TextWrapping="Wrap"/>
              <TextBlock x:Name="SanityStatus" Visibility="Collapsed" FontSize="10" Foreground="{DynamicResource ThemeSubtleBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border x:Name="FullUpdateCard" Grid.Row="2" Background="{DynamicResource WidgetCardBrush}" CornerRadius="11" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
          <Grid>
            <Grid x:Name="FullUpdateLayout">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="ScheduleHeading" Text="{DynamicResource Locale.05152a9e6c259be1d6edfea8}" FontSize="10" Foreground="{DynamicResource ThemeMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock x:Name="VersionLabel" Grid.Row="1" Text="{DynamicResource Locale.d28c9a6886b84129506842cd}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="MaintenanceDate" Text="—" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource ThemeSecondaryTextBrush}" VerticalAlignment="Top" Margin="0,0,12,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="MaintenanceRange" Grid.Column="1" Text="—" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource ThemeSecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
              </Grid>
              <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="CountdownLabel" Text="{DynamicResource Locale.38c5657fe813bcae4963a00b}" FontSize="11" Foreground="{DynamicResource ThemeAccentBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="NewsStatus" Visibility="Collapsed" FontSize="10" Foreground="{DynamicResource ThemeSubtleBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Border x:Name="UpcomingCard" Grid.Row="3" Background="{DynamicResource WidgetCardBrush}" CornerRadius="11" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,12" Padding="14,12">
          <Grid x:Name="FullUpcomingLayout"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Locale.48dc0825a2ba3ba304264465}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedBrush}"/>
            <TextBlock x:Name="NextOperator" Grid.Row="1" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="NextBannerCountdown" Grid.Row="2" FontSize="11" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="NextBannerDate" Grid.Row="3" FontSize="11" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
          </Grid>
        </Border>
        <Button x:Name="PlayButton" Grid.Row="4" Background="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeInkBrush}" FontWeight="SemiBold" FontSize="12" ToolTip="{DynamicResource Locale.33dc404daf00dc212c8b65be}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{DynamicResource Locale.436e61016e26fcb773b97257}" Margin="0,0,0,9">
          <StackPanel Orientation="Horizontal"><Path Width="10" Height="12" Stretch="Uniform" Data="M0,0 L10,6 L0,12 Z" Fill="{DynamicResource ThemeInkBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock x:Name="PlayLabel" Text="{DynamicResource Locale.436e61016e26fcb773b97257}" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Grid Grid.Row="5">
          <TextBlock x:Name="SessionLabel" Visibility="Collapsed" FontSize="8" Foreground="{DynamicResource ThemeSecondaryTextBrush}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="FullCalendarButton" Padding="0" Width="30" Height="30" Margin="0,0,6,0" ToolTip="{DynamicResource Locale.d5d0a30b517e3beab07609d7}" AutomationProperties.Name="{DynamicResource Locale.d5d0a30b517e3beab07609d7}"><Path Width="14" Height="14" Stretch="Uniform" Data="M1,3 L13,3 L13,13 L1,13 Z M1,6 L13,6 M4,1 L4,4 M10,1 L10,4" Stroke="{DynamicResource ThemeTextBrush}" StrokeThickness="1.3"/></Button>
            <Button x:Name="RefreshButton" Background="{DynamicResource ThemeInputBrush}" Padding="0" Width="30" Height="30" ToolTip="{DynamicResource Locale.894c866ae13774e42a3ad89e}" Margin="0,0,6,0" AutomationProperties.Name="{DynamicResource Locale.894c866ae13774e42a3ad89e}">
              <Path Width="14" Height="14" Stretch="Uniform" Data="M12,5 A5,5 0 1 0 13,9 M12,2.5 L12,5 L9.5,5" Stroke="{DynamicResource ThemeTextBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Button>
            <Button x:Name="SettingsButton" Background="{DynamicResource ThemeInputBrush}" Padding="0" Width="30" Height="30" ToolTip="{DynamicResource Locale.74a883a037bc227f91891ab6}" AutomationProperties.Name="{DynamicResource Locale.74a883a037bc227f91891ab6}">
              <Path Width="16" Height="16" Stretch="Uniform" Data="M8,3 A5,5 0 1 1 8,13 A5,5 0 1 1 8,3 M8,6 A2,2 0 1 1 8,10 A2,2 0 1 1 8,6 M8,0.8 L8,3 M8,13 L8,15.2 M0.8,8 L3,8 M13,8 L15.2,8 M2.9,2.9 L4.5,4.5 M11.5,11.5 L13.1,13.1 M2.9,13.1 L4.5,11.5 M11.5,4.5 L13.1,2.9" Stroke="{DynamicResource ThemeTextBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>

  <Border x:Name="CompactView" Visibility="Collapsed" Margin="6" CornerRadius="16" Background="{DynamicResource WidgetBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="14">
    <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="62"/><RowDefinition x:Name="CompactUpdateRow" Height="67"/><RowDefinition x:Name="CompactNextRow" Height="32"/><RowDefinition Height="25"/></Grid.RowDefinitions>
      <Grid x:Name="CompactDragHandle" Grid.RowSpan="2" Background="Transparent">
        <Grid x:Name="CompactPortraitFade" Width="79" Height="104" HorizontalAlignment="Right" Margin="0,3,-2,0" VerticalAlignment="Top" ClipToBounds="True">
          <Grid.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.08"/><GradientStop Color="#FFFFFFFF" Offset="0.6"/><GradientStop Color="#80FFFFFF" Offset="0.82"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Grid.OpacityMask>
          <Grid x:Name="CompactPortraitTransform" Width="79" Height="104"><Grid.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.1"/><GradientStop Color="#FFFFFFFF" Offset="0.65"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Grid.OpacityMask><Image Source="{Binding Source, ElementName=OperatorImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"><Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.32"/><GradientStop Color="#FFFFFFFF" Offset="0.9"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Image.OpacityMask></Image></Grid>
        </Grid>
        <StackPanel VerticalAlignment="Top"><TextBlock Text="ENDFIELD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentBrush}"/><TextBlock Text="{Binding Text, ElementName=OperatorName}" FontSize="18" FontWeight="SemiBold" Margin="0,3,90,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CompactBannerEnd" Visibility="Collapsed" FontSize="8" Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,1,90,0" TextTrimming="CharacterEllipsis"/></StackPanel>
        <Button x:Name="CompactCloseButton" Style="{StaticResource HoverCloseButton}" Width="25" Height="25" Padding="0" VerticalAlignment="Top" HorizontalAlignment="Right" ToolTip="{DynamicResource Locale.ab8c3af14fb614b63eecda1f}" AutomationProperties.Name="{DynamicResource Locale.d68748b60c6e5235c59caa3c}"><Path Width="9" Height="9" Stretch="Uniform" Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource ThemeTextBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
      </Grid>
      <Grid x:Name="CompactSanityLayout" Grid.Row="1" IsHitTestVisible="False" Margin="0,4,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="CompactSanityValueRow" Margin="0,0,90,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="CompactSanityNumber" FontSize="24" FontWeight="Normal" Typography.NumeralAlignment="Tabular"/><TextBlock x:Name="CompactSanityMaximum" FontSize="24" FontWeight="Normal" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/></StackPanel>
          <TextBlock x:Name="CompactSanityCaption" Grid.Column="1" Text="{DynamicResource Locale.919bd23a0d8fbbd3f2bf9e95}" FontSize="10" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
          <Grid x:Name="CompactSanityRing" Grid.Column="1" Width="30" Height="30" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"><Ellipse Margin="3" Stroke="{DynamicResource ThemeTrackBrush}" StrokeThickness="2.5"/><Path x:Name="CompactRingArc" Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="{Binding Text, ElementName=SanityPercent}" FontSize="7" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
        </Grid>
        <ProgressBar x:Name="CompactSanityBar" Grid.Row="1" Margin="0,0,90,0" Height="3" VerticalAlignment="Top" Maximum="100" Value="{Binding Value, ElementName=SanityBar}" Background="{DynamicResource ThemeTrackBrush}" Foreground="{DynamicResource ThemeAccentBrush}" BorderThickness="0"/>
        <TextBlock x:Name="CompactRecoveryLabel" Grid.Row="2" FontSize="10" Margin="0,10,0,0" Foreground="{DynamicResource ThemeSecondaryTextBrush}" TextWrapping="Wrap"/>
      </Grid>
