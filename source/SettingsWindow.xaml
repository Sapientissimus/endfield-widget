<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Locale.6d92783bc3894f7f3af77fcc}" Width="512" Height="800" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{DynamicResource LocaleFontFamily}" Foreground="{DynamicResource ThemeTextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="NumberInput" TargetType="TextBox">
      <Setter Property="Width" Value="43"/><Setter Property="Height" Value="27"/><Setter Property="Padding" Value="4,3"/><Setter Property="FontSize" Value="12"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}"/><Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsScrollStyle" TargetType="ScrollViewer"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="0,0,8,0"/>
        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="6" Orientation="Vertical" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
          <ScrollViewer x:Name="PART_ContentHost"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{DynamicResource ThemeSoftAccentBrush}" Cursor="Hand" HorizontalAlignment="Left">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border Background="Transparent" Padding="0,3"><StackPanel Orientation="Horizontal"><TextBlock x:Name="HelpChevron" Text="›" FontSize="16" Foreground="{DynamicResource ThemeSoftAccentBrush}" Margin="0,-4,7,0"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border>
              <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="HelpChevron" Property="Text" Value="⌄"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="ExpandedContent" Content="{TemplateBinding Content}" Visibility="Collapsed"/>
        </StackPanel>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Width="42" Height="24">
          <Border x:Name="SwitchTrack" Background="{DynamicResource ThemeTrackBrush}" CornerRadius="12"/>
          <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="{DynamicResource ThemeSecondaryTextBrush}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/><Setter TargetName="SwitchThumb" Property="Fill" Value="{DynamicResource ThemeInkBrush}"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,4,0"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
          <Track.Thumb><Thumb Width="6" MinWidth="0"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource ThemeBorderBrush}" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider"><Setter Property="Height" Value="27"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="TickFrequency" Value="5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="7,0">
        <Border Height="4" Background="{DynamicResource ThemeTrackBrush}" CornerRadius="2" VerticalAlignment="Center"/>
        <Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource ThemeAccentBrush}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Margin="8" CornerRadius="17" Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
    <Grid Margin="22,20">
      <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="59"/></Grid.RowDefinitions>
      <Grid x:Name="SettingsDragHandle" Background="Transparent">
        <StackPanel>
          <TextBlock Text="ENDFIELD" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentBrush}"/>
          <TextBlock Text="{DynamicResource Locale.74a883a037bc227f91891ab6}" FontSize="27" FontWeight="SemiBold" Margin="-1,7,0,0"/>
        </StackPanel>
        <Button x:Name="SettingsCloseButton" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" Background="{DynamicResource ThemeInputBrush}" ToolTip="{DynamicResource Locale.0ccfef82895026e2194c1ba7}" AutomationProperties.Name="{DynamicResource Locale.0ccfef82895026e2194c1ba7}">
          <Path Width="10" Height="10" Stretch="Uniform" Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource ThemeTextBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Button>
      </Grid>
      <ScrollViewer x:Name="SettingsScroll" Style="{StaticResource SettingsScrollStyle}" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,-7,0" Padding="0,0,7,0" PanningMode="VerticalOnly">
        <StackPanel x:Name="SettingsSections">
          <Border x:Name="GameSettingsCard" CornerRadius="11" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
            <StackPanel x:Name="GameSettingsPanel">
              <StackPanel Orientation="Horizontal"><TextBlock Text="◈" FontSize="17" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,-1,8,0"/><TextBlock Text="{DynamicResource Locale.5c412a262086b9701cda0630}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
              <TextBlock Text="{DynamicResource Locale.830ef117e1386dfc8c1c2220}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,12,0,6"/>
              <ComboBox x:Name="RegionSelector" Height="35" FontSize="12"/>
              <TextBlock x:Name="BannerCheckStatus" Visibility="Collapsed" FontSize="9" TextWrapping="Wrap" Foreground="{DynamicResource ThemeSubtleBrush}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border x:Name="AccountSettingsCard" CornerRadius="11" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
            <StackPanel x:Name="AccountSettingsPanel">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="◎" FontSize="17" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,-1,8,0"/><TextBlock Grid.Column="1" Text="{DynamicResource Locale.017324d3fa0b5ec173188b26}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/></Grid>
                <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource ThemeBadgeBrush}" CornerRadius="4" Padding="7,4" VerticalAlignment="Center"><TextBlock x:Name="AccountConnectionBadge" Text="{DynamicResource Locale.0303e182467081801f8b6148}" FontSize="9" Foreground="{DynamicResource ThemeMutedBrush}"/></Border>
              </Grid>
              <Button x:Name="OpenSkportButton" Content="{DynamicResource Locale.75c30e65c55708a859f822bb}" HorizontalAlignment="Left" FontSize="11" Padding="10,7" Margin="0,12,0,13"/>
              <TextBlock Text="{DynamicResource Locale.5ee3f7371586a03f13071aaa}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,0,0,6"/>
              <PasswordBox x:Name="TokenInput" Height="39" Padding="10,6" FontSize="14" VerticalContentAlignment="Center" Cursor="IBeam" Margin="0,0,0,10" Background="{DynamicResource ThemeInputBrush}" Foreground="{DynamicResource ThemeTextBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" AutomationProperties.Name="{DynamicResource Locale.6780940c9a226a887808a721}"/>
              <TextBlock x:Name="TokenHint" Visibility="Collapsed" FontSize="9" Foreground="{DynamicResource ThemeSubtleBrush}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ConnectAccountButton" Content="{DynamicResource Locale.f7d845186faa7ab8c4ab6029}" Background="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeInkBrush}" FontWeight="SemiBold" FontSize="11" Height="35"/>
                <Button x:Name="DisconnectAccountButton" Grid.Column="1" Content="{DynamicResource Locale.acfc5be785a9bb3da11c9f05}" FontSize="10" Height="35" Margin="8,0,0,0" Visibility="Collapsed"/>
              </Grid>
              <StackPanel x:Name="CharacterRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource Locale.19cd78f5eaf2217b56fa720a}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="CharacterSelector" Height="35" FontSize="11"/>
              </StackPanel>
              <TextBlock x:Name="ConnectionMessage" Visibility="Collapsed" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,9,0,0"/>
              <Expander x:Name="TokenHelp" Margin="0,12,0,0" Foreground="{DynamicResource ThemeMutedBrush}">
                <Expander.Header><TextBlock Text="{DynamicResource Locale.393b6cb094c985804edd5360}" FontSize="10" Foreground="{DynamicResource ThemeSoftAccentBrush}"/></Expander.Header>
                <Border Background="{DynamicResource ThemeRaisedBrush}" CornerRadius="6" Padding="11" Margin="0,8,0,0">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Locale.c32c15382e695c7a822e22a0}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                    <Button x:Name="OpenTokenPageButton" Content="{DynamicResource Locale.35ae8c8e93658de16e3a4dd7}" HorizontalAlignment="Left" FontSize="10" Padding="9,6" Margin="0,10,0,0"/>
                  </StackPanel>
                </Border>
              </Expander>
            </StackPanel>
          </Border>
          <Border x:Name="AppearanceSettingsCard" CornerRadius="11" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
            <StackPanel x:Name="AppearanceSettingsPanel"><TextBlock Text="{DynamicResource Locale.3907fa7f80722a6fc58cd8c1}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <StackPanel x:Name="LayoutModesPanel"><Grid><TextBlock Text="{DynamicResource Locale.e82b2a16228150ae98c68d6e}" FontSize="12" VerticalAlignment="Center"/><CheckBox x:Name="CompactSwitch" Style="{StaticResource SettingsSwitch}" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource Locale.e82b2a16228150ae98c68d6e}"/></Grid></StackPanel>
              <Grid Margin="0,16,0,0"><TextBlock Text="{DynamicResource Locale.dea0eeb711575258adf05cc8}" FontSize="12" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="ScaleInput" Style="{StaticResource NumberInput}" AutomationProperties.Name="{DynamicResource Locale.fdef2714b323f6e5c53dbd95}"/><TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{DynamicResource ThemeMutedBrush}"/><Button x:Name="ScaleReset" Content="100%" FontSize="10" Padding="7,4" ToolTip="{DynamicResource Locale.4f46a5564c03aed3aabcb648}" AutomationProperties.Name="{DynamicResource Locale.50f6c61ebc56874d973985fc}"/></StackPanel></Grid>
              <Slider x:Name="ScaleSlider" Minimum="75" Maximum="130" SmallChange="1" LargeChange="10" TickFrequency="1" AutomationProperties.Name="{DynamicResource Locale.dea0eeb711575258adf05cc8}"/>
              <Grid Margin="0,10,0,0"><TextBlock Text="{DynamicResource Locale.a6b74db5547fe5e4476c075e}" FontSize="12" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="CompactScaleInput" Style="{StaticResource NumberInput}" AutomationProperties.Name="{DynamicResource Locale.bd6663494f396d1acfae3e35}"/><TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{DynamicResource ThemeMutedBrush}"/><Button x:Name="CompactScaleReset" Content="100%" FontSize="10" Padding="7,4" ToolTip="{DynamicResource Locale.f3d1b058e38f478f75cbc147}" AutomationProperties.Name="{DynamicResource Locale.e3e4f16bcddab9f9449257ee}"/></StackPanel></Grid>
              <Slider x:Name="CompactScaleSlider" Minimum="75" Maximum="130" SmallChange="1" LargeChange="10" TickFrequency="1" AutomationProperties.Name="{DynamicResource Locale.a6b74db5547fe5e4476c075e}"/>
              <StackPanel x:Name="MiniScalePanel"/>
              <Grid Margin="0,10,0,0"><TextBlock Text="{DynamicResource Locale.284935fb8743e4115c9aa962}" FontSize="12"/><TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource ThemeAccentBrush}"/></Grid>
              <Slider x:Name="OpacitySlider" Minimum="60" Maximum="100" SmallChange="5" LargeChange="10" AutomationProperties.Name="{DynamicResource Locale.284935fb8743e4115c9aa962}"/>
              <Grid x:Name="PortraitOpacityRow" Margin="0,10,0,0"><TextBlock Text="{DynamicResource Locale.d1ee49791db661d2f09abe73}" FontSize="12"/><TextBlock x:Name="PortraitOpacityValue" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource ThemeAccentBrush}"/></Grid>
              <Slider x:Name="PortraitOpacitySlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" AutomationProperties.Name="{DynamicResource Locale.d1ee49791db661d2f09abe73}"/>
              <Grid x:Name="WatermarkSettingRow" Margin="0,10,0,0"><TextBlock Text="{DynamicResource Locale.7ccddb32776365e77babf212}" FontSize="12" VerticalAlignment="Center"/><CheckBox x:Name="WatermarkSwitch" Style="{StaticResource SettingsSwitch}" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource Locale.b0f8364b94303bb8102449da}"/></Grid>
              <Expander x:Name="VisibleBlocks" Margin="0,12,0,0" Foreground="{DynamicResource ThemeTextBrush}"><Expander.Header><TextBlock Text="{DynamicResource Locale.a440fa3cd653e2c200affb7a}" FontSize="12" Foreground="{DynamicResource ThemeSoftAccentBrush}"/></Expander.Header>
                <StackPanel Margin="0,11,0,0">
                  <Grid><TextBlock Text="{DynamicResource Locale.17ccfa5b681e3e7b29316598}" FontSize="12" VerticalAlignment="Center"/><CheckBox x:Name="ShowUpdateSwitch" Style="{StaticResource SettingsSwitch}" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource Locale.45a72117edd7f930ca88ba4e}"/></Grid>
                  <Grid Margin="0,12,0,0"><TextBlock Text="{DynamicResource Locale.3e881a8fe08566d8678ef0f0}" FontSize="12" VerticalAlignment="Center"/><CheckBox x:Name="ShowNextSwitch" Style="{StaticResource SettingsSwitch}" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource Locale.d8c2783b943e1ecfebbd35d3}"/></Grid>
                  <Grid Margin="0,12,0,0"><TextBlock Text="{DynamicResource Locale.62eecd9cb29ba711ad61be19}" FontSize="12" VerticalAlignment="Center"/><CheckBox x:Name="ShowPlaySwitch" Style="{StaticResource SettingsSwitch}" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource Locale.a70b243ee87ff01fe8c43706}"/></Grid>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border x:Name="DesktopSettingsCard" CornerRadius="11" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
            <StackPanel x:Name="DesktopSettingsPanel">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,11"><TextBlock Text="▣" FontSize="16" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Locale.4df9939944a7b324991dfbe4}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Locale.20cd3751f574e2322a44cee8}" FontSize="12" VerticalAlignment="Center"/>
                <CheckBox x:Name="PositionLockSwitch" Grid.Column="1" Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center" ToolTip="{DynamicResource Locale.ea8a3a031e9c7e9ff5491bf2}" AutomationProperties.Name="{DynamicResource Locale.20cd3751f574e2322a44cee8}"/>
              </Grid>
              <Grid Margin="0,15,0,0"><TextBlock Text="{DynamicResource Locale.0bfcd9317d0d439103d99966}" FontSize="12" VerticalAlignment="Center"/><CheckBox x:Name="StartupSwitch" Style="{StaticResource SettingsSwitch}" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource Locale.eec40d30986b056e0ff58f0e}"/></Grid>
              <Grid Margin="0,15,0,0" ToolTip="{DynamicResource Locale.ced69ffa6575b07ffdc11f9e}"><TextBlock Text="{DynamicResource Locale.2b9fff840cdd866e4a5ea5c7}" FontSize="12" VerticalAlignment="Center"/><CheckBox x:Name="ClickThroughSwitch" Style="{StaticResource SettingsSwitch}" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource Locale.ad35c2f2867013e0319ce9f8}"/></Grid>
              <Grid Margin="0,15,0,0"><TextBlock Text="{DynamicResource Locale.79ee9903f7dd8a121d50a3d9}" FontSize="12"/><TextBlock x:Name="ToggleHotkeyLabel" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource ThemeSoftAccentBrush}"/></Grid>
            </StackPanel>
          </Border>
          <Border x:Name="NotificationsSettingsCard" CornerRadius="11" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
            <StackPanel x:Name="NotificationsSettingsPanel"><TextBlock Text="{DynamicResource Locale.788011833a5a0f22db90c91e}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <Grid><TextBlock Text="{DynamicResource Locale.7e2d391bba385335d82d2b6f}" FontSize="12" VerticalAlignment="Center"/><CheckBox x:Name="SanityNotifySwitch" Style="{StaticResource SettingsSwitch}" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource Locale.56d89231673b438770747335}"/></Grid>
              <Grid x:Name="SanityNoticeOptions" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="43"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="SanityNoticeMode" Height="30" FontSize="11" Margin="0,0,10,0" AutomationProperties.Name="{DynamicResource Locale.1e612983990b025daf21750e}"/><TextBox x:Name="SanityNoticeValue" Grid.Column="1" Style="{StaticResource NumberInput}" AutomationProperties.Name="{DynamicResource Locale.02a8dd4d09936b829d0ee390}"/><TextBlock x:Name="SanityNoticeUnit" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource ThemeMutedBrush}"/></Grid>
              <Grid Margin="0,15,0,0"><TextBlock Text="{DynamicResource Locale.8107bcbbcc36543fa273772f}" FontSize="12" VerticalAlignment="Center"/><CheckBox x:Name="MaintenanceNotifySwitch" Style="{StaticResource SettingsSwitch}" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource Locale.9e8d614c3c81f3214971fe1c}"/></Grid>
              <Grid x:Name="MaintenanceNoticeOptions" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Locale.a49612e8346c005a3e7da301}" FontSize="12" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="MaintenanceNoticeValue" Style="{StaticResource NumberInput}" AutomationProperties.Name="{DynamicResource Locale.423a7670730f81d3862de50a}"/><TextBlock x:Name="MaintenanceNoticeUnit" Text="{DynamicResource Locale.97bd17d6d0e50d849bf12b7a}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource ThemeMutedBrush}"/></StackPanel></Grid>
              <Border Height="1" Background="{DynamicResource ThemeBorderBrush}" Margin="0,15"/>
              <Grid ToolTip="{DynamicResource Locale.d716c2d21ffdd33a5e0bb928}"><TextBlock Text="{DynamicResource Locale.91be9c8bd9b9e3e2fac2cc61}" FontSize="12" VerticalAlignment="Center"/><CheckBox x:Name="FullscreenQuietSwitch" Style="{StaticResource SettingsSwitch}" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource Locale.91be9c8bd9b9e3e2fac2cc61}"/></Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="0,13,0,0">
        <TextBlock x:Name="SettingsFeedback" Visibility="Collapsed" MaxWidth="285" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
        <Button x:Name="SettingsDoneButton" Content="{DynamicResource Locale.11a6767d5674c7e45f7e00dc}" Width="104" Height="36" FontSize="12" FontWeight="SemiBold" Background="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeInkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </Border>
</Window>
